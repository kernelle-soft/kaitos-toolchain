#!/usr/bin/env bash

: <<'DOC'
Project environment configuration, loaded automatically by direnv.

Sets up:
  - KAITOSHOME and CI_ENVRC for script imports
  - Toolchain and Godot version info
  - PATH for local Godot binary
  - Common shell functions (log, import)

The PATH guard prevents duplicate entries when sourced multiple times.

In CI, the .github/actions/envrc action sets CI_ENVRC, and scripts
call `eval "${CI_ENVRC:-}"` to load this file.

The `log` function is an alias for `echo "$1" >&2`, making
consistent output control easy and searchable, and prevents
debugging `echo` calls leaking into function outputs.

The `import` function allows for less verbose syntax when sourcing
reusable files and functions.
DOC

# shellcheck disable=SC2155
export KAITOSHOME="$(git rev-parse --show-toplevel)"
export CI_ENVRC="source $KAITOSHOME/.envrc"

# TODO: move these over to kaitos.json
export TOOLCHAIN_NAME="kaitos"
export TOOLCHAIN_VERSION="0.0.1"
export GODOT_VERSION="4.5.1"
export GODOT_URL="https://github.com/godotengine/godot/releases/download"

function __envrc__source_global_functions() {
  # shellcheck disable=SC1091
  source "$KAITOSHOME/scripts/shared/log.api.sh"

  # shellcheck disable=SC1091
  source "$KAITOSHOME/scripts/shared/import.func.sh"
}

function __envrc__add_godot_local_path() {
  export GODOT_LOCAL_PATH="$KAITOSHOME/bin/godot/$GODOT_VERSION"

  # Only add to PATH once to avoid duplicates
  if [[ ":$PATH:" != *":$GODOT_LOCAL_PATH:"* ]]; then
    export PATH="$PATH:$GODOT_LOCAL_PATH"
  fi
}

function __envrc__add_cargo_bin_path() {
  export CARGO_BIN_PATH="$HOME/.cargo/bin"
  if [[ ":$PATH:" != *":$CARGO_BIN_PATH:"* ]]; then
    export PATH="$PATH:$CARGO_BIN_PATH"
  fi
}

__envrc__add_godot_local_path
__envrc__add_cargo_bin_path
__envrc__source_global_functions
