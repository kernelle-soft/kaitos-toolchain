#!/usr/bin/env bash
# shellcheck disable=SC1091

: <<'DOC'
Environment configuration for the kaitos toolchain.

Serves two contexts:
  - Dev: loaded automatically by direnv when working in the repo
  - Install: sourced by the bootstrapper after extracting the release tarball
    (KAITOSHOME must be pre-set to the tarball root)

Sets up:
  - KAITOSHOME (git root in dev, pre-set in install)
  - Canonical version info (managed block, synced from manifest.json)
  - Common shell functions (log, import)
  - Dev-only: CI_ENVRC, PATH for local Godot binary and cargo

The @managed block is maintained by scripts/chores/sync_manifest_env.sh
and should not be edited manually.
DOC

# Context detection
if [[ -n "${KAITOSHOME:-}" ]]; then
  __KAITOS_CONTEXT="install"
else
  KAITOSHOME="$(git rev-parse --show-toplevel)"
  __KAITOS_CONTEXT="dev"
fi

# Maintained by automation. DO NOT TOUCH
# @managed:begin
GODOT_VERSION="4.5.1"
GODOT_URL="https://github.com/godotengine/godot/releases/download"
# @managed:end

function __envrc__source_global_functions() {
  source "$KAITOSHOME/scripts/shared/log.api.sh"
  source "$KAITOSHOME/scripts/shared/import.func.sh"
}

function __envrc__add_godot_local_path() {
  export GODOT_LOCAL_PATH="$KAITOSHOME/bin/godot/$GODOT_VERSION"

  if [[ ":$PATH:" != *":$GODOT_LOCAL_PATH:"* ]]; then
    export PATH="$PATH:$GODOT_LOCAL_PATH"
  fi
}

function __envrc__add_cargo_bin_path() {
  export CARGO_BIN_PATH="$HOME/.cargo/bin"
  if [[ ":$PATH:" != *":$CARGO_BIN_PATH:"* ]]; then
    export PATH="$PATH:$CARGO_BIN_PATH"
  fi
}

export \
  KAITOSHOME \
  GODOT_VERSION \
  GODOT_URL

if [[ "$__KAITOS_CONTEXT" == "dev" ]]; then
  CI_ENVRC="source $KAITOSHOME/.envrc"
  export CI_ENVRC

  __envrc__add_godot_local_path
  __envrc__add_cargo_bin_path
fi

__envrc__source_global_functions
