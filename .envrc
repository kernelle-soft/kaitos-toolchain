#!/usr/bin/env bash
# shellcheck disable=SC1091

: <<'DOC'
Environment configuration for the kaitos toolchain.

Serves two contexts:
  - Dev: loaded automatically by direnv when working in the repo
  - Install: sourced by the bootstrapper after extracting the release tarball
    (PROJ must be pre-set to the tarball root)

Sets up:
  - PROJ (git root in dev, pre-set in install)
  - Canonical version info (managed block, synced from manifest.json)
  - Common shell functions (log, import)
  - Dev-only: PATH for cargo

The @managed block is maintained by automation
and should not be edited manually.
DOC

# Context detection
if [[ -n "${PROJ:-}" ]]; then
  __KAITOS_CONTEXT__="install"
else
  PROJ="$(git rev-parse --show-toplevel)"
  __KAITOS_CONTEXT__="dev"
fi

# Maintained by github workflows (see _bump_version.yaml). DO NOT TOUCH
# @managed:begin
GODOT_VERSION="4.5.1"
GODOT_URL="https://github.com/godotengine/godot/releases/download"
# @managed:end

function __envrc__add_cargo_bin_path() {
  export CARGO_BIN_PATH="$HOME/.cargo/bin"
  if [[ ":$PATH:" != *":$CARGO_BIN_PATH:"* ]]; then
    export PATH="$PATH:$CARGO_BIN_PATH"
  fi
}

export \
  PROJ \
  GODOT_VERSION \
  GODOT_URL

source "$PROJ/shell/.shock/.envrc"

if [[ "$__KAITOS_CONTEXT__" == "dev" ]]; then
  __envrc__add_cargo_bin_path
fi
